{
  "name": "dsh-all-in-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "All In One：把独立小工具收拢到设置页的统一外壳。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./preset-pack": "./preset-pack.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./preset-isolate": "./preset-isolate.js"
  },
  "files": [
    "index.js",
    "client.js",
    "preset-pack.js",
    "preset-isolate.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsx build.ts",
    "dev": "tsx build.ts --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
